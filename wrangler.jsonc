{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zterminal-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [{ "pattern": "zterminal.dpdns.org", "custom_domain": true }],
  "vars": {
    "NEXTAUTH_URL": "https://zterminal.dpdns.org",
    "NEXTAUTH_URL_INTERNAL": "https://zterminal.dpdns.org",
    "AUTH_TRUST_HOST": "true"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "ZTERMINAL_ARTIFACTS",
      "bucket_name": "zterminal-prod-artifacts"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zterminal-web"
    }
  ],
  "observability": {
    "enabled": true
  }
}
