{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zterminal-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "zterminal.dpdns.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://zterminal.dpdns.org",
    "NEXTAUTH_URL_INTERNAL": "https://zterminal.dpdns.org",
    "AUTH_TRUST_HOST": "true",
    "ZTERMINAL_HELPER_RELEASE_ALLOWED_HOSTS": "github.com",
    "ZTERMINAL_HELPER_RELEASE_MANIFEST_JSON": "{\"version\":\"1.1.0-preview.1\",\"format\":\"portable-zip\",\"platform\":\"windows\",\"architecture\":\"x64\",\"protocol\":1,\"researchSchemas\":[1,2],\"features\":[\"synthetic_next_open_v2\",\"research_analyses_v1\",\"indicator_dataset_v2\"],\"sha256\":\"9d0c509683d34614207a9c46e6f600b38b2f8d05f2d4d86232b687ee0ad610a9\",\"bytes\":180295527,\"download_url\":\"https://github.com/zephyriaa/zterminal/releases/download/helper-v1.1.0-preview.1/zterminal-helper-1.1.0-preview.1-windows-x64.zip\"}"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "ZTERMINAL_ARTIFACTS",
      "bucket_name": "zterminal-prod-artifacts"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zterminal-web"
    }
  ],
  "observability": {
    "enabled": true
  }
}
