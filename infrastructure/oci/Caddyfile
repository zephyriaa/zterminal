{
	email {$LETSENCRYPT_EMAIL:security@zterminal.org}
}

{$API_DOMAIN:localhost} {
	encode zstd gzip

	@api path /v1/* /health /ready /docs /openapi.json
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		respond "ZTerminal API Gateway" 200
	}
}
