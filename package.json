{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && shx cp -r .next/static .next/standalone/.next/ && shx cp -r public .next/standalone/ && node scripts/verify-monaco.mjs .next/standalone/public",
    "build:production": "prisma generate --schema=prisma/schema.postgresql.prisma && node scripts/prepare-monaco.mjs && next build && shx cp -r .next/static .next/standalone/.next/ && shx cp -r public .next/standalone/ && node scripts/verify-monaco.mjs .next/standalone/public",
    "cf:build": "prisma generate --schema=prisma/schema.postgresql.prisma && opennextjs-cloudflare build && node scripts/verify-monaco.mjs .open-next/assets",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "start:production": "bash scripts/start-production.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "market-data": "tsx mini-services/market-data/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:python": "powershell -ExecutionPolicy Bypass -File scripts/test-python.ps1",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:generate:production": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "prebuild": "node -e \"try { require('child_process').execSync('npx prisma generate', {stdio:'inherit'}) } catch (e) { console.log('Prisma client already generated, proceeding...') }\" && node scripts/prepare-monaco.mjs",
    "predev": "prisma generate && node scripts/prepare-monaco.mjs",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/windows-host/scripts/build-winui.ps1 -Launch",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/windows-host/scripts/build-winui.ps1",
    "desktop:native:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/windows-host/scripts/build-winui.ps1 -Launch",
    "desktop:native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/windows-host/scripts/build-winui.ps1",
    "desktop:diagnostic:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/windows-host/scripts/build-native.ps1 -Launch",
    "desktop:diagnostic:build": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/windows-host/scripts/build-native.ps1",
    "workstation:dev": "vite --config apps/workstation/vite.config.ts",
    "workstation:build": "vite build --config apps/workstation/vite.config.ts",
    "desktop:hosted-preview:dev": "tauri dev --config src-tauri/tauri.internal-hosted-preview.conf.json",
    "desktop:hosted-preview:build": "tauri build --config src-tauri/tauri.internal-hosted-preview.conf.json",
    "tauri": "tauri",
    "test:terminal": "node scripts/test-terminal-browser.cjs",
    "test:landing": "node scripts/test-landing-browser.cjs",
    "test:drafts": "node scripts/test-draft-recovery.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@opennextjs/aws": "^4.1.5",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tauri-apps/api": "^2.11.1",
    "@types/ws": "^8.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview-core": "^8.3.1",
    "dockview-react": "^8.3.1",
    "framer-motion": "^12.23.2",
    "lenis": "^1.3.26",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.525.0",
    "monaco-editor": "0.55.1",
    "next": "16.3.6",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^3.0.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "ws": "^8.21.3",
    "zod": "^4.0.2",
    "zterminal-research-wasm": "file:./packages/zterminal-research-wasm",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun": "^1.4.2",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
