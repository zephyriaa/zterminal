generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String?     @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workspaces    Workspace[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?  @db.Text
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id                String               @id @default(cuid())
  ownerId           String?
  name              String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  owner             User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  datasets          Dataset[]
  strategies        Strategy[]
  riskPlans         RiskPlan[]
  alerts            AlertDefinition[]
  journals          JournalEntry[]
  backtests         BacktestRun[]
  audits            AuditEvent[]
  researchSources   ResearchSource[]
  ruleSpecs         RuleSpec[]
  protocolDecisions ProtocolDecision[]
  datasetImports    DatasetImport[]
  cloudState        CloudWorkspaceState?

  @@index([ownerId])
}

model CloudWorkspaceState {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  schemaVersion Int       @default(1)
  payload       String    @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Strategy {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    StrategyVersion[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model StrategyVersion {
  id                     String                     @id @default(cuid())
  strategyId             String
  version                Int
  language               String
  source                 String?                    @db.Text
  structuredDefinition   String?                    @db.Text
  parameterSchema        String                     @db.Text
  riskModel              String                     @db.Text
  sourceHash             String
  datasetId              String?
  createdAt              DateTime                   @default(now())
  strategy               Strategy                   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  dataset                Dataset?                   @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  backtests              BacktestRun[]
  journals               JournalEntry[]
  generatedArtifactId    String?
  protocolClassification String                     @default("NON_PROTOCOL")
  parentVersionId        String?
  generatedArtifact      GeneratedStrategyArtifact? @relation(fields: [generatedArtifactId], references: [id], onDelete: SetNull)
  parentVersion          StrategyVersion?           @relation("StrategyVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions          StrategyVersion[]          @relation("StrategyVersionLineage")

  @@unique([strategyId, version])
  @@index([strategyId])
  @@index([datasetId])
  @@index([sourceHash])
}

model Dataset {
  id               String            @id @default(cuid())
  workspaceId      String
  provider         String
  environment      String
  symbols          String
  timeframe        String
  exchangeTimezone String
  requestedFromMs  Float
  requestedToMs    Float
  contentHash      String?
  qualityStatus    String
  provenance       String            @db.Text
  createdAt        DateTime          @default(now())
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersions StrategyVersion[]
  backtests        BacktestRun[]
  imports          DatasetImport[]

  @@index([workspaceId, createdAt])
  @@index([contentHash])
}

model BacktestRun {
  id                  String                     @id @default(cuid())
  workspaceId         String
  strategyVersionId   String?
  datasetId           String?
  determinismHash     String                     @unique
  config              String                     @db.Text
  parameters          String                     @db.Text
  metrics             String                     @db.Text
  tradeLog            String                     @db.Text
  equityCurve         String                     @db.Text
  validationStatus    String                     @default("unvalidated")
  runClass            String                     @default("LEGACY")
  baselineFingerprint String?                    @unique
  generatedArtifactId String?
  parentRunId         String?
  protocolWarnings    String                     @default("[]") @db.Text
  generatedArtifact   GeneratedStrategyArtifact? @relation(fields: [generatedArtifactId], references: [id], onDelete: SetNull)
  parentRun           BacktestRun?               @relation("BacktestRunLineage", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns           BacktestRun[]              @relation("BacktestRunLineage")
  variableChange      VariableChange?
  createdAt           DateTime                   @default(now())
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersion     StrategyVersion?           @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  dataset             Dataset?                   @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  journalEntries      JournalEntry[]

  @@index([workspaceId, createdAt])
  @@index([strategyVersionId])
  @@index([datasetId])
  @@index([generatedArtifactId])
  @@index([parentRunId])
}

model ResearchSource {
  id          String                  @id @default(cuid())
  workspaceId String
  title       String
  author      String
  year        Int
  sourceType  String
  reference   String                  @db.Text
  sourceText  String                  @db.Text
  contentHash String
  rightsNote  String?                 @db.Text
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  excerpts    ResearchSourceExcerpt[]
  ruleSpecs   RuleSpec[]

  @@index([workspaceId, createdAt])
  @@index([contentHash])
}

model ResearchSourceExcerpt {
  id                String         @id @default(cuid())
  sourceId          String
  locator           String
  text              String         @db.Text
  reviewerConfirmed Boolean        @default(false)
  createdAt         DateTime       @default(now())
  source            ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model RuleSpec {
  id                String             @id @default(cuid())
  workspaceId       String
  sourceId          String
  name              String
  stage             String
  deferredVariables String             @default("[]") @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source            ResearchSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  revisions         RuleSpecRevision[]
  decisions         ProtocolDecision[]

  @@index([workspaceId, stage])
  @@index([sourceId])
}

model RuleSpecRevision {
  id              String                      @id @default(cuid())
  ruleSpecId      String
  revision        Int
  entryRule       String                      @db.Text
  exitRule        String                      @db.Text
  sizingRule      String                      @db.Text
  excerptIds      String                      @default("[]") @db.Text
  scopeValidation String                      @db.Text
  contentHash     String
  createdAt       DateTime                    @default(now())
  ruleSpec        RuleSpec                    @relation(fields: [ruleSpecId], references: [id], onDelete: Cascade)
  assessments     DataRequirementAssessment[]
  artifacts       GeneratedStrategyArtifact[]

  @@unique([ruleSpecId, revision])
  @@index([contentHash])
}

model DataRequirementAssessment {
  id                 String           @id @default(cuid())
  ruleSpecRevisionId String
  requirements       String           @db.Text
  selectedDataset    String?          @db.Text
  readyForGeneration Boolean          @default(false)
  createdAt          DateTime         @default(now())
  ruleSpecRevision   RuleSpecRevision @relation(fields: [ruleSpecRevisionId], references: [id], onDelete: Cascade)

  @@index([ruleSpecRevisionId, createdAt])
}

model DatasetImport {
  id            String    @id @default(cuid())
  workspaceId   String
  datasetId     String?
  sourceMode    String
  fileHash      String?
  schemaVersion String
  qualityReport String    @db.Text
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataset       Dataset?  @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([datasetId])
}

model GeneratedStrategyArtifact {
  id                      String            @id @default(cuid())
  ruleSpecRevisionId      String
  language                String
  source                  String            @db.Text
  semanticManifest        String            @db.Text
  assumptions             String            @db.Text
  unsupportedRequirements String            @default("[]") @db.Text
  extrasDetected          String            @default("[]") @db.Text
  approval                String
  generatorProvider       String
  generatorReference      String?
  contentHash             String
  createdAt               DateTime          @default(now())
  ruleSpecRevision        RuleSpecRevision  @relation(fields: [ruleSpecRevisionId], references: [id], onDelete: Restrict)
  strategyVersions        StrategyVersion[]
  backtests               BacktestRun[]

  @@index([ruleSpecRevisionId, createdAt])
  @@index([contentHash])
}

model VariableChange {
  id        String      @id @default(cuid())
  runId     String      @unique
  label     String
  kind      String
  before    String      @db.Text
  after     String      @db.Text
  rationale String      @db.Text
  createdAt DateTime    @default(now())
  run       BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ProtocolDecision {
  id          String    @id @default(cuid())
  workspaceId String
  ruleSpecId  String?
  type        String
  detail      String    @db.Text
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ruleSpec    RuleSpec? @relation(fields: [ruleSpecId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([ruleSpecId, createdAt])
}

model RiskPlan {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  currency         String
  accountEquity    Float
  maxRiskPerTrade  Float
  maxDailyLoss     Float
  maxWeeklyLoss    Float
  maxGrossExposure Float
  policy           String    @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

model AlertDefinition {
  id              String    @id @default(cuid())
  workspaceId     String
  type            String
  instrument      String
  rule            String    @db.Text
  context         String    @db.Text
  enabled         Boolean   @default(true)
  cooldownMs      Int
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@index([instrument, enabled])
}

model JournalEntry {
  id                String           @id @default(cuid())
  workspaceId       String
  strategyVersionId String?
  backtestRunId     String?
  instrument        String
  direction         String?
  entryTime         DateTime?
  exitTime          DateTime?
  entryPrice        Float?
  stopPrice         Float?
  targetPrice       Float?
  exitPrice         Float?
  quantity          Float?
  pnl               Float?
  rMultiple         Float?
  regime            String?
  context           String           @db.Text
  notes             String           @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  backtestRun       BacktestRun?     @relation(fields: [backtestRunId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([strategyVersionId])
  @@index([backtestRunId])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  payload     String    @db.Text
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}
