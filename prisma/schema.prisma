generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * Authentication is intentionally not wired yet. Product records use an optional owner
 * relationship so the schema can be introduced without fabricating an auth mechanism.
 */
model User {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspaces Workspace[]
}

/**
 * Legacy scaffold retained temporarily to keep the first migration additive for existing local databases.
 * No product code may depend on this model; removal requires a separately approved data-retention migration.
 */
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id         String            @id @default(cuid())
  ownerId    String?
  name       String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  owner      User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  datasets   Dataset[]
  strategies Strategy[]
  riskPlans  RiskPlan[]
  alerts     AlertDefinition[]
  journals   JournalEntry[]
  backtests  BacktestRun[]
  audits     AuditEvent[]

  @@index([ownerId])
}

/**
 * Strategy identity; immutable authored behavior lives in StrategyVersion.
 */
model Strategy {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    StrategyVersion[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/**
 * JSON-like fields are Strings intentionally: SQLite support is retained and parsing stays
 * explicit at the application boundary. `sourceHash` identifies exact authored content.
 */
model StrategyVersion {
  id                   String         @id @default(cuid())
  strategyId           String
  version              Int
  language             String
  source               String?
  structuredDefinition String?
  parameterSchema      String
  riskModel            String
  sourceHash           String
  datasetId            String?
  createdAt            DateTime       @default(now())
  strategy             Strategy       @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  dataset              Dataset?       @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  backtests            BacktestRun[]
  journals             JournalEntry[]

  @@unique([strategyId, version])
  @@index([strategyId])
  @@index([datasetId])
  @@index([sourceHash])
}

/**
 * Reproducible historical-data request and provenance metadata; raw tick storage is out of scope.
 */
model Dataset {
  id               String            @id @default(cuid())
  workspaceId      String
  provider         String
  environment      String
  symbols          String
  timeframe        String
  exchangeTimezone String
  requestedFromMs  Int
  requestedToMs    Int
  contentHash      String?
  qualityStatus    String
  provenance       String
  createdAt        DateTime          @default(now())
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersions StrategyVersion[]
  backtests        BacktestRun[]

  @@index([workspaceId, createdAt])
  @@index([contentHash])
}

/**
 * A deterministic run points to immutable strategy/dataset inputs and stores its complete result artifact.
 */
model BacktestRun {
  id                String           @id @default(cuid())
  workspaceId       String
  strategyVersionId String?
  datasetId         String?
  determinismHash   String           @unique
  config            String
  parameters        String
  metrics           String
  tradeLog          String
  equityCurve       String
  validationStatus  String           @default("unvalidated")
  createdAt         DateTime         @default(now())
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  dataset           Dataset?         @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  journals          JournalEntry[]

  @@index([workspaceId, createdAt])
  @@index([strategyVersionId])
  @@index([datasetId])
}

/**
 * No broker credential, token, or order-routing authority is stored here.
 */
model RiskPlan {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  currency         String
  accountEquity    Float
  maxRiskPerTrade  Float
  maxDailyLoss     Float
  maxWeeklyLoss    Float
  maxGrossExposure Float
  policy           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

/**
 * Alert definition metadata only; evaluation, delivery, retry, and deduplication are worker concerns.
 */
model AlertDefinition {
  id              String    @id @default(cuid())
  workspaceId     String
  type            String
  instrument      String
  rule            String
  context         String
  enabled         Boolean   @default(true)
  cooldownMs      Int
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@index([instrument, enabled])
}

model JournalEntry {
  id                String           @id @default(cuid())
  workspaceId       String
  strategyVersionId String?
  backtestRunId     String?
  instrument        String
  direction         String?
  entryTime         DateTime?
  exitTime          DateTime?
  entryPrice        Float?
  stopPrice         Float?
  targetPrice       Float?
  exitPrice         Float?
  quantity          Float?
  pnl               Float?
  rMultiple         Float?
  regime            String?
  context           String
  notes             String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  backtestRun       BacktestRun?     @relation(fields: [backtestRunId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([strategyVersionId])
  @@index([backtestRunId])
}

/**
 * Redacted, append-only action record. Payload must never contain secrets or broker credentials.
 */
model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  payload     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}
