generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * Authentication is intentionally not wired yet. Product records use an optional owner
 * relationship so the schema can be introduced without fabricating an auth mechanism.
 */
model User {
  id            String      @id @default(cuid())
  email         String?     @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workspaces    Workspace[]
  accounts      Account[]
  sessions      Session[]
}

/**
 * Google OAuth accounts are persisted only by the server-side Auth.js adapter.
 * The application never exposes provider tokens to the browser or stores broker credentials.
 */
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/**
 * Server-side session records; browser code receives only an opaque secure cookie.
 */
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * Legacy scaffold retained temporarily to keep the first migration additive for existing local databases.
 * No product code may depend on this model; removal requires a separately approved data-retention migration.
 */
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id                String               @id @default(cuid())
  ownerId           String?
  name              String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  owner             User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  datasets          Dataset[]
  strategies        Strategy[]
  riskPlans         RiskPlan[]
  alerts            AlertDefinition[]
  journals          JournalEntry[]
  backtests         BacktestRun[]
  audits            AuditEvent[]
  researchSources   ResearchSource[]
  ruleSpecs         RuleSpec[]
  protocolDecisions ProtocolDecision[]
  datasetImports    DatasetImport[]
  cloudState        CloudWorkspaceState?

  @@index([ownerId])
}

/**
 * Versioned terminal preferences synchronized for one authenticated workspace.
 * The JSON envelope is validated at the API boundary and excludes credentials,
 * market-provider secrets, orders, balances, and any execution authority.
 */
model CloudWorkspaceState {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  schemaVersion Int       @default(1)
  payload       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * Strategy identity; immutable authored behavior lives in StrategyVersion.
 */
model Strategy {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    StrategyVersion[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/**
 * JSON-like fields are Strings intentionally: SQLite support is retained and parsing stays
 * explicit at the application boundary. `sourceHash` identifies exact authored content.
 */
model StrategyVersion {
  id                     String                     @id @default(cuid())
  strategyId             String
  version                Int
  language               String
  source                 String?
  structuredDefinition   String?
  parameterSchema        String
  riskModel              String
  sourceHash             String
  datasetId              String?
  createdAt              DateTime                   @default(now())
  strategy               Strategy                   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  dataset                Dataset?                   @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  backtests              BacktestRun[]
  journals               JournalEntry[]
  generatedArtifactId    String?
  protocolClassification String                     @default("NON_PROTOCOL")
  parentVersionId        String?
  generatedArtifact      GeneratedStrategyArtifact? @relation(fields: [generatedArtifactId], references: [id], onDelete: SetNull)
  parentVersion          StrategyVersion?           @relation("StrategyVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions          StrategyVersion[]          @relation("StrategyVersionLineage")

  @@unique([strategyId, version])
  @@index([strategyId])
  @@index([datasetId])
  @@index([sourceHash])
}

/**
 * Reproducible historical-data request and provenance metadata; raw tick storage is out of scope.
 */
model Dataset {
  id               String            @id @default(cuid())
  workspaceId      String
  provider         String
  environment      String
  symbols          String
  timeframe        String
  exchangeTimezone String
  requestedFromMs  Int
  requestedToMs    Int
  contentHash      String?
  qualityStatus    String
  provenance       String
  createdAt        DateTime          @default(now())
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersions StrategyVersion[]
  backtests        BacktestRun[]
  imports          DatasetImport[]

  @@index([workspaceId, createdAt])
  @@index([contentHash])
}

/**
 * A deterministic run points to immutable strategy/dataset inputs and stores its complete result artifact.
 */
model BacktestRun {
  id                  String                     @id @default(cuid())
  workspaceId         String
  strategyVersionId   String?
  datasetId           String?
  determinismHash     String                     @unique
  config              String
  parameters          String
  metrics             String
  tradeLog            String
  equityCurve         String
  validationStatus    String                     @default("unvalidated")
  runClass            String                     @default("LEGACY")
  baselineFingerprint String?                    @unique
  generatedArtifactId String?
  parentRunId         String?
  protocolWarnings    String                     @default("[]")
  generatedArtifact   GeneratedStrategyArtifact? @relation(fields: [generatedArtifactId], references: [id], onDelete: SetNull)
  parentRun           BacktestRun?               @relation("BacktestRunLineage", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns           BacktestRun[]              @relation("BacktestRunLineage")
  variableChange      VariableChange?
  createdAt           DateTime                   @default(now())
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersion     StrategyVersion?           @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  dataset             Dataset?                   @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  journalEntries      JournalEntry[]

  @@index([workspaceId, createdAt])
  @@index([strategyVersionId])
  @@index([datasetId])
  @@index([generatedArtifactId])
  @@index([parentRunId])
}

model ResearchSource {
  id          String                  @id @default(cuid())
  workspaceId String
  title       String
  author      String
  year        Int
  sourceType  String
  reference   String
  sourceText  String
  contentHash String
  rightsNote  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  excerpts    ResearchSourceExcerpt[]
  ruleSpecs   RuleSpec[]

  @@index([workspaceId, createdAt])
  @@index([contentHash])
}

model ResearchSourceExcerpt {
  id                String         @id @default(cuid())
  sourceId          String
  locator           String
  text              String
  reviewerConfirmed Boolean        @default(false)
  createdAt         DateTime       @default(now())
  source            ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model RuleSpec {
  id                String             @id @default(cuid())
  workspaceId       String
  sourceId          String
  name              String
  stage             String
  deferredVariables String             @default("[]")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source            ResearchSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  revisions         RuleSpecRevision[]
  decisions         ProtocolDecision[]

  @@index([workspaceId, stage])
  @@index([sourceId])
}

model RuleSpecRevision {
  id              String                      @id @default(cuid())
  ruleSpecId      String
  revision        Int
  entryRule       String
  exitRule        String
  sizingRule      String
  excerptIds      String                      @default("[]")
  scopeValidation String
  contentHash     String
  createdAt       DateTime                    @default(now())
  ruleSpec        RuleSpec                    @relation(fields: [ruleSpecId], references: [id], onDelete: Cascade)
  assessments     DataRequirementAssessment[]
  artifacts       GeneratedStrategyArtifact[]

  @@unique([ruleSpecId, revision])
  @@index([contentHash])
}

model DataRequirementAssessment {
  id                 String           @id @default(cuid())
  ruleSpecRevisionId String
  requirements       String
  selectedDataset    String?
  readyForGeneration Boolean          @default(false)
  createdAt          DateTime         @default(now())
  ruleSpecRevision   RuleSpecRevision @relation(fields: [ruleSpecRevisionId], references: [id], onDelete: Cascade)

  @@index([ruleSpecRevisionId, createdAt])
}

model DatasetImport {
  id            String    @id @default(cuid())
  workspaceId   String
  datasetId     String?
  sourceMode    String
  fileHash      String?
  schemaVersion String
  qualityReport String
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataset       Dataset?  @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([datasetId])
}

model GeneratedStrategyArtifact {
  id                      String            @id @default(cuid())
  ruleSpecRevisionId      String
  language                String
  source                  String
  semanticManifest        String
  assumptions             String
  unsupportedRequirements String            @default("[]")
  extrasDetected          String            @default("[]")
  approval                String
  generatorProvider       String
  generatorReference      String?
  contentHash             String
  createdAt               DateTime          @default(now())
  ruleSpecRevision        RuleSpecRevision  @relation(fields: [ruleSpecRevisionId], references: [id], onDelete: Restrict)
  strategyVersions        StrategyVersion[]
  backtests               BacktestRun[]

  @@index([ruleSpecRevisionId, createdAt])
  @@index([contentHash])
}

model VariableChange {
  id        String      @id @default(cuid())
  runId     String      @unique
  label     String
  kind      String
  before    String
  after     String
  rationale String
  createdAt DateTime    @default(now())
  run       BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ProtocolDecision {
  id          String    @id @default(cuid())
  workspaceId String
  ruleSpecId  String?
  type        String
  detail      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ruleSpec    RuleSpec? @relation(fields: [ruleSpecId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([ruleSpecId, createdAt])
}

/**
 * No broker credential, token, or order-routing authority is stored here.
 */
model RiskPlan {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  currency         String
  accountEquity    Float
  maxRiskPerTrade  Float
  maxDailyLoss     Float
  maxWeeklyLoss    Float
  maxGrossExposure Float
  policy           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

/**
 * Alert definition metadata only; evaluation, delivery, retry, and deduplication are worker concerns.
 */
model AlertDefinition {
  id              String    @id @default(cuid())
  workspaceId     String
  type            String
  instrument      String
  rule            String
  context         String
  enabled         Boolean   @default(true)
  cooldownMs      Int
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@index([instrument, enabled])
}

model JournalEntry {
  id                String           @id @default(cuid())
  workspaceId       String
  strategyVersionId String?
  backtestRunId     String?
  instrument        String
  direction         String?
  entryTime         DateTime?
  exitTime          DateTime?
  entryPrice        Float?
  stopPrice         Float?
  targetPrice       Float?
  exitPrice         Float?
  quantity          Float?
  pnl               Float?
  rMultiple         Float?
  regime            String?
  context           String
  notes             String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  backtestRun       BacktestRun?     @relation(fields: [backtestRunId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([strategyVersionId])
  @@index([backtestRunId])
}

/**
 * Redacted, append-only action record. Payload must never contain secrets or broker credentials.
 */
model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  payload     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}
