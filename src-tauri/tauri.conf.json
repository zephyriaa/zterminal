{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZTerminal",
  "version": "0.2.2",
  "identifier": "com.zterminal.workstation",
  "build": {
    "beforeDevCommand": "npm run workstation:dev",
    "beforeBuildCommand": "npm run workstation:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../out/workstation"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "ZTerminal — Quantitative Workstation",
        "width": 1440,
        "height": 900,
        "minWidth": 683,
        "minHeight": 384,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
