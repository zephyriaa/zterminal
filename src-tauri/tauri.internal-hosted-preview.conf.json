{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZTerminal Terminal Preview (Internal)",
  "version": "0.2.2",
  "identifier": "com.zterminal.internalhostedpreview",
  "build": {
    "beforeBuildCommand": null,
    "beforeDevCommand": null,
    "devUrl": "https://zterminal.onrender.com/terminal",
    "frontendDist": "https://zterminal.onrender.com/terminal"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZTerminal Terminal Preview — Internal Hosted Build",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
