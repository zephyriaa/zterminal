# Server / Market Data
MARKET_DATA_PORT=3003
MARKET_PROVIDER=mock
ALLOWED_ORIGIN=http://localhost:3000
MAX_SUBSCRIPTIONS_PER_CLIENT=8
# Optional private Python research service. Its legacy job endpoints stay
# unavailable through the web app until owner-scoped job storage is implemented.
# RESEARCH_API_URL=https://private-research.example
# RESEARCH_SERVICE_SECRET=server_to_server_secret

# Auth: use the exact browser origin for each environment (local, preview, production).
# The Google Cloud web OAuth client must register this origin and
# NEXTAUTH_URL/api/auth/callback/google as authorized URLs.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Database
# Local dev: leave unset for automatic SQLite (db/custom.db)
# Production Node and Cloudflare Workers: PostgreSQL connection string.
# For Supabase, use its session-mode pooler URL and replace [YOUR-PASSWORD]
# only in the Worker secret manager. Never commit a real connection string.
# DATABASE_URL=postgresql://user:password@host:5432/zterminal
